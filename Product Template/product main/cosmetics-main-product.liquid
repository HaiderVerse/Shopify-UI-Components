            <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </span>
      </button>
      <div class="swiper" data-popup-carousel>
        <div class="swiper-wrapper">
          {% for image in product.images %}
            <div class="swiper-slide product-gallery_gallerySlide__aNFX8" data-media-id="{{ image.id }}">
              <figure class="product-gallery_galleryImgWrapper__sv_XK product-gallery_whileOpen__TjP9F">
                <img class="product-gallery_galleryImage__reMDc" src="{{ image | image_url: width: 2000 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
              </figure>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="carousel-utils_absoluteContainer__XUmD8 product-gallery_galleryArrows__C_cyz" data-popup-arrows>
        <button class="carousel-utils_arrowL__e_hk7" aria-label="Previous slide" data-popup-arrow="prev">
          <span class="icon_iconContainer__lS_O1">
            <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12.75 4.5L7.25 10L12.75 15.5" stroke="currentColor" stroke-width="2" stroke-linejoin="bevel"></path>
            </svg>
          </span>
        </button>
        <button class="carousel-utils_arrowR__7AZ0v" aria-label="Next slide" data-popup-arrow="next">
          <span class="icon_iconContainer__lS_O1">
            <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7.25 4.5L12.75 10L7.25 15.5" stroke="currentColor" stroke-width="2" stroke-linejoin="bevel"></path>
            </svg>
          </span>
