            <h2 class="product-intro_pdpShortDesc___SLJk">{{ product.description | strip_html | truncate: 140 }}</h2>
          {% endif %}

          <div class="product-intro_showOnDesktopOnly__qAyia" data-thumbs-desktop>
            <ul class="product-gallery-navigator_navigatorContainer product-gallery-navigator_contentStart__4Tnou" role="radiogroup">
              {% for image in product.images %}
                <li>
                  <button
                    class="product-gallery-navigator_navigatorButton {% if forloop.first %}product-gallery-navigator_active{% endif %}"
                    role="radio"
                    aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                    data-gallery-thumb
                    data-index="{{ forloop.index0 }}"
                  >
                    <div class="product-gallery-navigator_wrapperImage__TS9_N">
                      <img
                        alt="{{ image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="42"
                        height="42"
                        class="product-gallery-navigator_galleryImage__BGIA8"
                        src="{{ image | image_url: width: 96, height: 96, crop: 'center' }}"
                      >
                    </div>
                  </button>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="product-gallery_pdpGallery__XHv7M" data-main-gallery>
          <div class="product-gallery_galleryWrapper__o1648">
            <div class="swiper product-gallery_galleryCarousel" data-gallery-carousel>
              <div class="swiper-wrapper">
