                <button type="button" class="product-shade-selector_shadesCount" data-shades-toggle>+{{ product.variants.size }}</button>
              </div>

              <div class="product-shade-selector_wrapperShades" data-shades-wrapper>
                <div class="product-shade-selector_shadesSelector pane_pane__h9PPS" data-variants-list>
                  {% for variant in product.variants %}
                    <button
                      type="button"
                      class="{% if variant.id == selected_variant.id %}product-shade-selector_selectedShadeSelectorButton__6WqQv{% else %}product-shade-selector_shadeSelectorButton__RJJvK{% endif %}"
                      data-variant-id="{{ variant.id }}"
                      aria-label="Select {{ variant.title }}"
                    >
                      <span class="product-shade-selector_shadeImageWrapper__roXhZ">
                        {% if variant.metafields.custom.shades_image != blank %}
                          <img
                            class="product-shade-selector_shadeImage__kWj40"
                            src="{{ variant.metafields.custom.shades_image | image_url: width: 24, height: 24, crop: 'center' }}"
                            alt="{{ variant.title | escape }}"
                            width="20"
                            height="20"
                          >
                        {% elsif variant.featured_image %}
                          <img
                            class="product-shade-selector_shadeImage__kWj40"
                            src="{{ variant.featured_image | image_url: width: 24, height: 24, crop: 'center' }}"
                            alt="{{ variant.title | escape }}"
                            width="20"
                            height="20"
                          >
                        {% endif %}
                        {% unless variant.available %}
                          <span class="product-shade-selector_outOfStock__4dIoQ"></span>
                        {% endunless %}
                      </span>
                      <span class="product-shade-selector_shadeSelectorCode__gz5SC">{{ variant.option1 | default: variant.title | truncate: 6, '' }}</span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            </div>

            <div class="pane_pane__h9PPS product-info_purchaseInfo__sLVhC">
              <div class="product-stacked-price_priceInfo__Imdcp">
                <span class="product-stacked-price_displayPrice__Dl4Da" data-variant-price>{{ selected_variant.price | money }}</span>
              </div>

              <div class="product-actions_wrapperPrimary__8ww4a">
                <div class="quantity-selector_quantitySelector__kmlGJ product-actions_quantitySelectorPrio__uEyhI product-actions_quantitySelector__Y87w7" data-quantity-wrap>
                  <button type="button" class="beacon-cart-mod-btn quantity-selector_quantityButton__9Uixa" aria-label="Decrease quantity" data-qty-action="decrease">-</button>
                  <input
                    class="quantity-selector_quantityInput__ZG_I4"
                    type="number"
                    min="0"
                    step="1"
                    value="0"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    data-quantity-input
                  >
                  <button type="button" class="beacon-cart-mod-btn quantity-selector_quantityButton__9Uixa" aria-label="Increase quantity" data-qty-action="increase">+</button>
                </div>

                <button
                  type="button"
                  class="button_button__EFbAC button_primary__p_Jiz product-actions_primary__jSvHi beacon-cart-mod-btn"
                  data-add-to-bag
                >
                  Add to bag
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="product-more-info_pdpTabs__8bOJN">
          <button class="product-more-info_disclosureButton" type="button" aria-expanded="true" data-headlessui-state="open">
            <h2>Description</h2>
            <span class="icon_iconContainer__lS_O1">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M6 8L10 12L14 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </button>
          <div class="product-more-info_disclosurePanel" data-headlessui-state="open">
            <div class="product-more-info_panelInner__A3yNV rte">{{ product.description }}</div>
          </div>

          <button class="product-more-info_disclosureButton" type="button" aria-expanded="false">
            <h2>Delivery</h2>
            <span class="icon_iconContainer__lS_O1">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M6 8L10 12L14 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </button>
          <div class="product-more-info_disclosurePanel">
            <div class="product-more-info_panelInner__A3yNV">Fast shipping and secure checkout.</div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<div id="headlessui-portal-root" style="display:none;" data-headlessui-portal-state="">
  <div class="product-gallery_galleryDialog__b4AJu" role="dialog" aria-modal="true">
    <div class="product-gallery_galleryPanel__OOiQ1">
      <button class="product-gallery_galleryPanelClose__ySOUG" aria-label="Close gallery" data-close-popup>
