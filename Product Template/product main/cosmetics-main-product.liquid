                    <button class="product-gallery_galleryButton__S3y_y product-gallery_galleryDesktop__rMEYO" aria-label="Open gallery" tabindex="-1">
                      <figure class="product-gallery_galleryImgWrapper__sv_XK">
                        <img
                          class="product-gallery_galleryImage__reMDc"
                          alt="{{ image.alt | default: product.title | escape }}"
                          src="{{ image | image_url: width: 1600 }}"
                          loading="lazy"
                        >
                      </figure>
                    </button>
                  </div>
                {% endfor %}
              </div>
            </div>

            <button class="product-gallery_openGallery__3sV0O" aria-label="Open gallery" data-open-popup>
              <span class="icon_iconContainer__lS_O1">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M13.6 12.6 18 17M9.6 5.5v6M6.5 8.6h6m2.7 0A5.6 5.6 0 1 1 4 8.6a5.6 5.6 0 0 1 11.2 0Z" stroke="currentColor" stroke-width="2" stroke-linejoin="bevel"></path>
                </svg>
              </span>
            </button>
          </div>

          <div class="carousel-utils_absoluteContainer__XUmD8 product-gallery_galleryArrows__C_cyz" data-gallery-arrows>
            <button class="carousel-utils_arrowL__e_hk7" aria-label="Previous slide" data-arrow="prev">
              <span class="icon_iconContainer__lS_O1">
                <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12.75 4.5L7.25 10L12.75 15.5" stroke="currentColor" stroke-width="2" stroke-linejoin="bevel"></path>
                </svg>
              </span>
            </button>
            <button class="carousel-utils_arrowR__7AZ0v" aria-label="Next slide" data-arrow="next">
              <span class="icon_iconContainer__lS_O1">
                <svg width="24" height="24" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M7.25 4.5L12.75 10L7.25 15.5" stroke="currentColor" stroke-width="2" stroke-linejoin="bevel"></path>
                </svg>
              </span>
            </button>
          </div>

          <ul class="product-gallery_galleryNav__0zXQy product-gallery-navigator_contentCenter__4hzaP" role="radiogroup" data-thumbs-main>
            {% for image in product.images %}
              <li>
                <button
                  class="product-gallery-navigator_navigatorButton {% if forloop.first %}product-gallery-navigator_active{% endif %}"
                  role="radio"
                  aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-gallery-thumb
                  data-index="{{ forloop.index0 }}"
                >
                  <div class="product-gallery-navigator_wrapperImage__TS9_N">
                    <img
                      alt="{{ image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="42"
                      height="42"
                      class="product-gallery-navigator_galleryImage__BGIA8"
                      src="{{ image | image_url: width: 96, height: 96, crop: 'center' }}"
                    >
                  </div>
                </button>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div class="product-info_pdpInfo__XiTlu">
          <div class="product-info_pdpInfoColumn__0_C_C">
            <div class="pane_pane__h9PPS">
              <div class="product-shade-selector_shadesHeader__brdn5">
