      </div>

      <ul class="product-gallery_galleryNav__0zXQy product-gallery-navigator_contentCenter__4hzaP" role="radiogroup" data-popup-thumbs>
        {% for image in product.images %}
          <li>
            <button class="product-gallery-navigator_navigatorButton {% if forloop.first %}product-gallery-navigator_active{% endif %}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" data-popup-thumb data-index="{{ forloop.index0 }}">
              <div class="product-gallery-navigator_wrapperImage__TS9_N">
                <img
                  alt="{{ image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="42"
                  height="42"
                  class="product-gallery-navigator_galleryImage__BGIA8"
                  src="{{ image | image_url: width: 96, height: 96, crop: 'center' }}"
                >
              </div>
            </button>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

