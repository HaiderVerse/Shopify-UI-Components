{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign image_count = product.images.size %}

{% stylesheet %}
  :root {
    --fromRGBA: rgba(0, 0, 0, 0.15);
  }
{% endstylesheet %}

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.css"
  integrity="sha512-pmAAV1X4Nh5jA9m+jcvwJXFQvCBi3T17aZ1KWkqXr7g/O2YMvO8rfaa5ETWDuBvRq6fbDjlw4jHL44jNTScaKg=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
>
{{ 'cosmetics-main-product.css' | asset_url | stylesheet_tag }}
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js"
  integrity="sha512-Ysw1DcK1P+uYLqprEAzNQJP+J4hTx4t/3X2nbVwszao8wD+9afLjBQYjz7Uk4ADP+Er++mJoScI42ueGtQOzEA=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
  defer
></script>
<script src="{{ 'cosmetics-main-product.js' | asset_url }}" defer></script>

<div
  id="CosmeticsPdp-{{ section.id }}"
  class="page-width"
  data-cosmetics-pdp
  data-section-id="{{ section.id }}"
  data-media-count="{{ image_count }}"
>
  <script type="application/json" data-product-json>
    {
      "productId": {{ product.id }},
      "selectedVariantId": {{ selected_variant.id }},
      "moneyFormat": {{ shop.money_format | json }},
      "variants": [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id }},
            "title": {{ variant.title | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price }},
            "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
            "inventory_management": {{ variant.inventory_management | json }},
            "inventory_policy": {{ variant.inventory_policy | json }},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},
            "shade_image": {% if variant.metafields.custom.shades_image != blank %}{{ variant.metafields.custom.shades_image | image_url: width: 64 | json }}{% elsif variant.featured_image %}{{ variant.featured_image | image_url: width: 64 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>

  <div class="grid_container__b6Ooy product-showcase_pdpGrid__lmfe8">
    <div class="product-showcase_pdpContainer__01wlr">
      <section class="product-showcase_section1__GhSdY">
        <div class="product-intro_pdpIntro__5MRHx">
